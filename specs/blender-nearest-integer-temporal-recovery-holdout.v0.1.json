  "adapterContract": {
    "inheritance": "D10.1 channel extraction and raster orientation with BFS_D111_MASTER replacing only the frozen view-layer name",
    "outputs": ["previous.rgba32", "current.rgba32", "previous-depth.f32", "current-depth.f32", "previous-layer.f32", "current-layer.f32", "motion.xy32"],
    "motion": "raw float32 [-current Vector.X,-current Vector.Y]; no rounding, snapping, epsilon, clamping or quantization in the adapter",
    "unusedValidated": "current Vector.ZW remains measured against current-minus-next"
  },
  "quantizerContract": {
    "input": "adapter motion.xy32 decoded strictly as little-endian finite IEEE-754 binary32",
    "domain": "every component must lie within 1/1024 pixel inclusive of its nearest mathematical integer; rejection is whole-array and produces no output payload",
    "acceptanceRadiusPixels": 0.0009765625,
    "candidate": "value >= 0 ? floor(value + 0.5) : ceil(value - 0.5)",
    "halfIntegerPolicy": "the candidate rule is half-away-from-zero, but every exact or adjacent half-integer is outside the 1/1024 domain and must be rejected",
    "output": "motion-quantized.xy32 containing exact integral float32 values; all zero candidates serialize as positive-zero bytes 00000000",
    "independence": "one scalar Python implementation and one scalar Node implementation share only this spec; they may not import one another, D11 quantization diagnostics or fixture expected motion",
    "requiredProperties": ["finite input", "whole-array atomic rejection", "inclusive radius", "nearest-integer exactness", "Python/Node byte identity", "idempotence", "positive-zero canonicalization", "report input/output hash binding"],
    "forbidden": ["toward-zero as quantizer", "floor as quantizer", "ceil as quantizer", "clamping", "subpixel resampling", "global epsilon", "fixture-specific expected-motion lookup", "partial output after rejection", "radius widening after output"]
  },
  "rawMotionGate": {
    "correctEndpointErrorP99MaximumPixels": 0.000244140625,
    "correctEndpointErrorAbsoluteMaximumPixels": 0.0009765625,
    "allPixelComponentsWithinQuantizerDomain": true,
    "movingOwnerQuantizedMotion": "Every analytically interior pixel belonging to each declared moving owner must equal expectedD9Motion exactly after quantization.",
    "staticQuantizedMotion": "Every static pixel must serialize as [+0,+0] float32 bytes.",
    "failureLabelForRealOutOfDomainInput": "QUANTIZER_DOMAIN"
  },
  "accumulatorContract": {
    "coordinates": "top-left integer pixel centers",
    "motionInput": "motion-quantized.xy32 from the matching-language quantizer; Python and Node quantized payloads must first be byte-identical",
    "motionIntegerization": "retain D11/D9.1 toward-zero semantics: Python int() and JavaScript Math.trunc(); exact integral float32 inputs make this operation an identity",
    "previousCoordinate": "q=(x-trunc(dx), y+trunc(dy))",
    "historyValid": "q in bounds AND currentLayerId==previousLayerId(q) AND abs(previousDepth(q)-currentDepth)<=max(1,currentDepth)/1024 AND both alpha>0",
    "accumulation": "valid: cast each 0.5*current+0.5*previous(q) result once to float32; invalid: current float32 scalar exactly",
    "producerIndependence": "scalar Python and scalar Node implementations do not import one another and retain the D11 accumulation algorithm after input/report wiring",
