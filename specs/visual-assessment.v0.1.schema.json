{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BFS VisualAssessment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "assessmentVersion", "assessmentId", "packetUri", "packetSha256", "reviewer", "issues", "strengthConfirmations"],
  "properties": {
    "documentType": {"const": "BFS_VISUAL_ASSESSMENT"},
    "assessmentVersion": {"const": "0.1.0"},
    "assessmentId": {"$ref": "#/$defs/id"},
    "packetUri": {"$ref": "#/$defs/repositoryUri"},
    "packetSha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": {"enum": ["VISION_MODEL_TEACHER", "VISION_MODEL_CANDIDATE", "HUMAN_REVIEWER"]},
        "version": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_.:-]+$"}
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issueId", "category", "severity", "confidence", "observation", "desiredOutcome", "evidence", "entityRefs", "treatment"],
        "properties": {
          "issueId": {"$ref": "#/$defs/id"},
          "category": {"enum": ["COMPOSITION", "MODELING", "MATERIAL", "ANIMATION", "LIGHTING", "CONTINUITY"]},
          "severity": {"enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "observation": {"type": "string", "minLength": 8, "maxLength": 400},
          "desiredOutcome": {"type": "string", "minLength": 8, "maxLength": 400},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frameId", "region"],
              "properties": {
                "frameId": {"$ref": "#/$defs/id"},
                "region": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": {"type": "number", "minimum": 0, "maximum": 1},
                    "y": {"type": "number", "minimum": 0, "maximum": 1},
                    "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                    "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
                  }
                }
              }
            }
          },
          "entityRefs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "treatment": {"enum": ["CLEAR_FOREGROUND_OCCLUSION", "REFRAME_FOR_SUBJECT_READABILITY", "REPLACE_PRIMITIVE_JOINT_WITH_LAYERED_ASSEMBLY", "ADD_MID_SCALE_SURFACE_HIERARCHY", "ADD_FACIAL_SEGMENTATION", "EXPAND_PERFORMANCE_BEATS"]}
        }
      }
    },
    "strengthConfirmations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strengthId", "evidenceFrameIds"],
        "properties": {
          "strengthId": {"$ref": "#/$defs/id"},
          "evidenceFrameIds": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repositoryUri": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./ -]+$"}
  }
}
