  "phaseBGates": [
    {
      "id": "PB.1",
      "title": "Repository and source identity",
      "status": "NOT_RUN",
      "acceptance": "Authorized repository preserves full Blender history at fa1b578bb421, exact F0 patch identity, independent branding and a clean native build; generated products remain outside Git"
    },
    {
      "id": "PB.2",
      "title": "Typed proposal and approval boundary",
      "status": "NOT_RUN",
      "acceptance": "B01 and B02 enter as typed SceneSpec proposals; rejected, tampered or unapproved proposals produce zero Blender mutation and zero unrestricted model bpy/shell authority"
    },
    {
      "id": "PB.3",
      "title": "Canonical compile and editable film workspace",
      "status": "NOT_RUN",
      "acceptance": "Approved B01/B02 compile to canonical-exact BuildPlans and semantic scene structures while Project/Scene/Shot/Character state persists and Expert Mode remains lossless"
    },
    {
      "id": "PB.4",
      "title": "Preview, final and receipts",
      "status": "NOT_RUN",
      "acceptance": "The product produces the frozen EEVEE preview and Cycles multilayer EXR with process, pixel, pass, cost and failure receipts plus independent audit"
    },
    {
      "id": "PB.5",
      "title": "Restart-safe job control",
      "status": "NOT_RUN",
      "acceptance": "A controlled interruption resumes without rerunning immutable completed stages; stale, forged and out-of-budget receipts fail closed before additional Blender work"
    },
    {
      "id": "PB.6",
      "title": "B62 three-shot vertical slice",
      "status": "NOT_RUN",
      "acceptance": "Wide/medium/close share frozen non-camera state, produce a reviewable three-shot output and retain the frame-288 composition rejection instead of weakening the human-quality boundary"
    },
    {
      "id": "PB.7",
      "title": "Human review and bounded prototype verdict",
      "status": "NOT_RUN",
      "acceptance": "Machine evidence and delayed human review are both recorded; the final verdict is PASS, FAIL or BLOCKED and never expands into a production-readiness or autonomous-filmmaking claim"
    }
  ],
