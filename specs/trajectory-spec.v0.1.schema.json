{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/trajectory-spec.v0.1.schema.json",
  "title": "BFS TrajectorySpec v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "specVersion", "id", "targetObject", "frameRate", "frameStart", "frameEnd", "space", "source", "samples", "acceptance", "selectionStatus", "security"],
  "properties": {
    "documentType": { "const": "BFS_TRAJECTORY_SPEC" },
    "specVersion": { "const": "0.1.0" },
    "id": { "const": "TRAJECTORY_B07_CANONICAL" },
    "targetObject": { "const": "B06_PROP" },
    "frameRate": { "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": { "numerator": { "const": 24 }, "denominator": { "const": 1 } } },
    "frameStart": { "const": 1 },
    "frameEnd": { "const": 132 },
    "space": { "const": "WORLD" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["experiment", "structureSha256", "evaluationUri", "evaluationSha256"],
      "properties": {
        "experiment": { "const": "B06_PHYSICS_V0_1" },
        "structureSha256": { "$ref": "#/$defs/sha256" },
        "evaluationUri": { "const": "experiments/physics-v0-1/B06.final-evaluation.json" },
        "evaluationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "samples": { "type": "array", "minItems": 132, "maxItems": 132, "items": { "$ref": "#/$defs/sample" } },
    "acceptance": { "type": "object", "additionalProperties": false, "required": ["maxReplayPositionErrorM", "maxReplayRotationErrorDeg"], "properties": { "maxReplayPositionErrorM": { "const": 1e-7 }, "maxReplayRotationErrorDeg": { "const": 1e-5 } } },
    "selectionStatus": { "const": "TECHNICAL_CANONICAL_CANDIDATE_NOT_HUMAN_APPROVED" },
    "security": { "type": "object", "additionalProperties": false, "required": ["networkAccess", "executableCode"], "properties": { "networkAccess": { "const": false }, "executableCode": { "const": false } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -1000000, "maximum": 1000000 } },
    "quat4": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": -1, "maximum": 1 } },
    "sample": { "type": "object", "additionalProperties": false, "required": ["frame", "locationM", "rotationQuaternionWxyz"], "properties": { "frame": { "type": "integer", "minimum": 1, "maximum": 132 }, "locationM": { "$ref": "#/$defs/vec3" }, "rotationQuaternionWxyz": { "$ref": "#/$defs/quat4" } } }
  }
}
