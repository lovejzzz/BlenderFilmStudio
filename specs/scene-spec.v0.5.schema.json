{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.5.schema.json",
  "title": "Blender Film Studio SceneSpec v0.5",
  "description": "SceneSpec v0.4 plus hash-pinned, physics-disabled world-transform trajectory replay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "shot", "assets", "actors", "targets", "attachments", "geometryEvaluations", "grasps", "trajectories", "cameras", "lights", "world", "events", "render", "security", "provenance"],
  "properties": {
    "specVersion": { "const": "0.5.0" },
    "shot": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/shot" },
    "assets": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/asset" }, "maxItems": 256 },
    "actors": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.2.schema.json#/$defs/actor" }, "maxItems": 32 },
    "targets": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.3.schema.json#/$defs/target" }, "maxItems": 256 },
    "attachments": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.3.schema.json#/$defs/attachment" }, "maxItems": 128 },
    "geometryEvaluations": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.3.schema.json#/$defs/geometryEvaluation" }, "maxItems": 128 },
    "grasps": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.4.schema.json#/$defs/graspBinding" }, "maxItems": 32 },
    "trajectories": { "type": "array", "items": { "$ref": "#/$defs/trajectoryBinding" }, "maxItems": 32 },
    "cameras": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/camera" }, "minItems": 1, "maxItems": 16 },
    "lights": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/light" }, "maxItems": 128 },
    "world": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/world" },
    "events": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/event" }, "maxItems": 512 },
    "render": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/render" },
    "security": { "$ref": "#/$defs/security" },
    "provenance": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "trajectoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trajectorySpecUri", "trajectorySpecSha256", "assetRef", "objectRef", "applicationMode", "disablePhysics"],
      "properties": {
        "id": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/id" },
        "trajectorySpecUri": { "type": "string", "minLength": 1, "maxLength": 512 },
        "trajectorySpecSha256": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/sha256" },
        "assetRef": { "$ref": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/scene-spec.v0.1.schema.json#/$defs/id" },
        "objectRef": { "type": "string", "minLength": 1, "maxLength": 120 },
        "applicationMode": { "const": "BAKED_WORLD_TRANSFORM" },
        "disablePhysics": { "const": true }
      }
    },
    "security": {
      "type": "object", "additionalProperties": false, "required": ["networkAccess", "arbitraryPython", "allowedAssetRoots", "allowedOperations"],
      "properties": {
        "networkAccess": { "const": false }, "arbitraryPython": { "const": false },
        "allowedAssetRoots": { "type": "array", "items": { "enum": ["assets/", "library/", "motion/"] }, "minItems": 1, "uniqueItems": true },
        "allowedOperations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["READ_MANIFEST", "IMPORT_ASSET", "IMPORT_ACTOR_SPEC", "IMPORT_ACTION", "CREATE_CAMERA", "CREATE_LIGHT", "CREATE_TARGET", "CREATE_CONSTRAINT", "CREATE_GRASP", "CREATE_TRAJECTORY_REPLAY", "EVALUATE_GEOMETRY", "SET_TRANSFORM", "APPLY_PERFORMANCE", "SET_RENDER", "RENDER_PREVIEW", "RENDER_FINAL"] }
        }
      }
    }
  }
}
