{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lovejzzz/BlenderFilmStudio/main/specs/human-review-response.v0.3.schema.json",
  "title": "BFS B05 Human Review Response v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "protocolVersion", "clipId", "clipSha256", "reviewerCode", "submittedAtUtc", "watchedTwice", "answers", "privacy"],
  "properties": {
    "documentType": { "const": "BFS_B05_HUMAN_REVIEW_RESPONSE" },
    "protocolVersion": { "const": "0.3.0" },
    "clipId": { "const": "CLIP_G52Q" },
    "clipSha256": { "const": "f7f7c1ce3eaf36cacf8f3c5f4d143fbdcce574bfb61633b9bc9238cbc4f8cbaa" },
    "reviewerCode": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,24}$" },
    "submittedAtUtc": { "type": "string", "format": "date-time" },
    "watchedTwice": { "const": true },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closureContinuity", "twoSidedContactReadability", "synchronizedTransport", "visibleMeshDrift", "visiblePop", "overallAcceptance", "note"],
      "properties": {
        "closureContinuity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "twoSidedContactReadability": { "type": "integer", "minimum": 1, "maximum": 5 },
        "synchronizedTransport": { "type": "integer", "minimum": 1, "maximum": 5 },
        "visibleMeshDrift": { "enum": ["YES", "NO", "UNSURE"] },
        "visiblePop": { "enum": ["YES", "NO", "UNSURE"] },
        "overallAcceptance": { "enum": ["PASS", "FAIL", "UNSURE"] },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transmitted", "personalDataRequested"],
      "properties": { "transmitted": { "const": false }, "personalDataRequested": { "const": false } }
    }
  }
}
