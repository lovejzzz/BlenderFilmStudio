{
  "schemaVersion": "bfs.workerLaunchContract.v0.1",
  "experimentId": "B38",
  "status": "PREREGISTERED_BEFORE_TOOLING_OR_OUTPUT",
  "question": "Can a trusted, backend-agnostic compiler turn a frozen worker request into one canonical fail-closed launch plan, with no inherited environment, no shell, mandatory Blender safety flags, one read-only input mount, one writable output mount, bounded resources, disk admission, and non-promotable failure receipts?",
  "runtime": {
    "nodeVersion": "v26.5.0",
    "nodeBinary": "/opt/homebrew/Cellar/node/26.5.0/bin/node",
