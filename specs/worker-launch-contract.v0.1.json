      "memoryBytes": 8589934592,
      "cpus": 4,
      "shmBytes": 1073741824
    },
    "diskAdmission": {
      "minimumReserveBytes": 107374182400,
      "defaultProjectedWriteBytes": 21474836480,
      "acceptWhen": "availableBytes - projectedWriteBytes >= minimumReserveBytes"
    },
    "recovery": {
      "wallTimeMs": 30000,
      "terminateSignal": "SIGTERM",
      "terminateGraceMs": 5000,
      "forceSignal": "SIGKILL",
