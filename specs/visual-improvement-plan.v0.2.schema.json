{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BFS VisualImprovementPlan v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "planVersion", "projectId", "iterationId", "source", "rubric", "decision", "priorities", "operations", "preservations", "rerenderSet", "lesson", "authority", "planHash"],
  "properties": {
    "documentType": {"const": "BFS_VISUAL_IMPROVEMENT_PLAN"},
    "planVersion": {"const": "0.2.0"},
    "projectId": {"$ref": "#/$defs/id"},
    "iterationId": {"$ref": "#/$defs/id"},
    "source": {"type": "object", "additionalProperties": false, "required": ["packetUri", "packetSha256", "assessmentUri", "assessmentSha256", "observedSceneSha256", "executionBaselineSha256"], "properties": {"packetUri": {"$ref": "#/$defs/repositoryUri"}, "packetSha256": {"$ref": "#/$defs/sha256"}, "assessmentUri": {"$ref": "#/$defs/repositoryUri"}, "assessmentSha256": {"$ref": "#/$defs/sha256"}, "observedSceneSha256": {"$ref": "#/$defs/sha256"}, "executionBaselineSha256": {"$ref": "#/$defs/sha256"}}},
    "rubric": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256", "version"], "properties": {"uri": {"$ref": "#/$defs/repositoryUri"}, "sha256": {"$ref": "#/$defs/sha256"}, "version": {"const": "0.2.0"}}},
    "decision": {"enum": ["COMPILED", "NEEDS_MORE_EVIDENCE"]},
    "priorities": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["rank", "issueId", "severity", "category", "confidence"], "properties": {"rank": {"type": "integer", "minimum": 1, "maximum": 128}, "issueId": {"$ref": "#/$defs/id"}, "severity": {"enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]}, "category": {"enum": ["COMPOSITION", "MODELING", "MATERIAL", "ANIMATION", "LIGHTING", "CONTINUITY"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "operations": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["operationId", "issueId", "operationType", "targetEntityIds", "shotIds", "preset", "parameters", "invariants", "evidenceFrameIds", "failureMechanisms"], "properties": {
      "operationId": {"$ref": "#/$defs/id"}, "issueId": {"$ref": "#/$defs/id"},
      "operationType": {"enum": ["RESOLVE_SCREENSPACE_OCCLUSION", "APPLY_FRAMING_CONSTRAINT", "REPLACE_FORM_WITH_CONTOUR_ASSEMBLY", "ADD_CONTOUR_DETAIL_SYSTEM"]},
      "targetEntityIds": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "shotIds": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "preset": {"enum": ["HIDE_NEAREST_NONSTORY_OCCLUDER", "FIT_BOUND_SUBJECT_WITH_MARGIN", "CONCENTRIC_CORE_SHELL_GAP", "LANDMARK_DRIVEN_FACEPLATE", "SPARSE_HIERARCHICAL_PANELING"]},
      "parameters": {"$ref": "#/$defs/parameters"},
      "invariants": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["PRESERVE_SCENE_IDENTITY", "PRESERVE_ANIMATION_ANCHORS", "PRESERVE_ACCEPTED_LIGHTING", "PRESERVE_CAMERA_LANGUAGE", "PRESERVE_ACCEPTED_COLOR", "PRESERVE_ACCEPTED_ATMOSPHERE", "NO_NEW_EXTERNAL_ASSET", "NO_EXECUTABLE_AUTHORITY", "NO_NAMED_PROJECT_SPECIAL_CASE"]}},
      "evidenceFrameIds": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "failureMechanisms": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}}
    }}},
    "preservations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["strengthId", "category", "evidenceFrameIds", "rule"], "properties": {"strengthId": {"$ref": "#/$defs/id"}, "category": {"enum": ["LIGHTING", "CAMERA_LANGUAGE", "COLOR", "ATMOSPHERE"]}, "evidenceFrameIds": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "rule": {"enum": ["PRESERVE_ACCEPTED_LIGHTING", "PRESERVE_ACCEPTED_CAMERA_LANGUAGE", "PRESERVE_ACCEPTED_COLOR", "PRESERVE_ACCEPTED_ATMOSPHERE"]}}}},
    "rerenderSet": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "lesson": {"type": "object", "additionalProperties": false, "required": ["rootCause", "antiPatterns"], "properties": {"rootCause": {"type": "string"}, "antiPatterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["semanticCatalogOnly", "allowsPython", "allowsShell", "allowsNetwork", "allowsArbitraryFilesystem", "requiresTypedExecutor"], "properties": {"semanticCatalogOnly": {"const": true}, "allowsPython": {"const": false}, "allowsShell": {"const": false}, "allowsNetwork": {"const": false}, "allowsArbitraryFilesystem": {"const": false}, "requiresTypedExecutor": {"const": true}}},
    "planHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "parameters": {"type": "object", "additionalProperties": false, "required": ["maximumOcclusionRatio", "minimumNegativeSpaceMargin", "targetOccupancyMin", "targetOccupancyMax", "maximumReliefDepthRatio", "maximumDetailCoverageRatio", "requiredScaleBands", "maximumSameScalePeers", "requiredFacialZones"], "properties": {"maximumOcclusionRatio": {"type": ["number", "null"], "minimum": 0, "maximum": 0.5}, "minimumNegativeSpaceMargin": {"type": ["number", "null"], "minimum": 0, "maximum": 0.3}, "targetOccupancyMin": {"type": ["number", "null"], "minimum": 0.1, "maximum": 0.9}, "targetOccupancyMax": {"type": ["number", "null"], "minimum": 0.1, "maximum": 0.95}, "maximumReliefDepthRatio": {"type": ["number", "null"], "minimum": 0, "maximum": 0.3}, "maximumDetailCoverageRatio": {"type": ["number", "null"], "minimum": 0, "maximum": 0.5}, "requiredScaleBands": {"type": ["integer", "null"], "minimum": 2, "maximum": 4}, "maximumSameScalePeers": {"type": ["integer", "null"], "minimum": 1, "maximum": 8}, "requiredFacialZones": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["EYE_LINE", "BROW", "CHEEK", "JAW"]}}}},
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repositoryUri": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./ -]+$"}
  }
}
