  "candidate": {
    "name": "Q30_PREVIOUS_CURVATURE_X4",
    "inputDomain": "D12.8 structurally valid radius-2 pixels; RGB and motion are read only from the previous frame and current Blender Vector; current RGB is forbidden from the decision",
    "support": "the 4x4 previous-frame rectangle [x0-1,x0+2] by [y0-1,y0+2] is in bounds, has one exact Object Index and alpha greater than 0.999",
