      "fractionBits": 30,
      "scale": 1073741824,
      "requirement": "every previous float32 RGB sample multiplied by 2^30 is an exact integer in the declared [0,1] derivation domain"
    },
    "motionFixedPoint": {
      "fractionBits": 24,
      "scale": 16777216,
      "requirement": "the fractional part of q=(x+Vector.X,y-Vector.Y), multiplied by 2^24, is an exact integer"
    },
    "curvature": "Mx is the per-channel maximum absolute horizontal second difference at x0 and x0+1 on rows y0 and y0+1; My is the analogous vertical maximum at y0 and y0+1 on columns x0 and x0+1; all colors are signed Q30 integers",
    "riskNumerator": "2 * (Fx*(2^24-Fx)*Mx + Fy*(2^24-Fy)*My)",
    "riskQ30": "ceil(riskNumerator / 2^48) + 512, saturated to uint32 maximum",
    "calibrationFactor": 4,
    "roundingAllowanceQ30": 512,
    "riskThresholdQ30Inclusive": 131072,
    "riskThresholdSceneLinear": 0.0001220703125,
    "qualityThresholdSceneLinear": 0.000030517578125,
    "reconstruction": "unchanged four-tap float64 bilinear sum followed by one float32 cast; reconstruction is measured but not an input to the risk decision",
    "fallback": "ineligible or risk-rejected pixels copy current float32 RGBA exactly in the future holdout"
  },
