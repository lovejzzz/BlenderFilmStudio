    "validate:spec-v05": "node scripts/validate-scene-spec-v05.mjs",
    "validate:actor": "node scripts/validate-actor-spec.mjs",
    "validate:grasp": "node scripts/validate-grasp-spec.mjs specs/benchmarks/B05.grasp.json --self-test --output experiments/grasp-v0-1/contract-self-test.json",
    "generate:scene-v04": "node scripts/generate-b05-scene-v04.mjs",
    "generate:scene-v05": "node scripts/generate-b08-scene-v05.mjs",
    "generate:trajectory-v01": "node scripts/generate-b07-trajectory.mjs",
