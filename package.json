    "experiment:compiler": "node scripts/run-compiler-experiment.mjs",
    "experiment:pixel": "node scripts/run-pixel-experiment.mjs",
    "experiment:mastering": "node scripts/run-mastering-experiment.mjs",
    "experiment:actor": "node scripts/run-actor-experiment.mjs",
    "experiment:actor-regeneration": "node scripts/run-actor-regeneration-experiment.mjs",
    "experiment:scene-v02": "node scripts/run-scene-v02-experiment.mjs",
