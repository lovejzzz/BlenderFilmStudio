    "experiment:grasp-compiler": "node scripts/run-b05-compiled-grasp-experiment.mjs",
    "experiment:physics": "node scripts/run-b06-physics-experiment.mjs",
    "experiment:physics-repro": "node scripts/run-b06-reproducibility-audit.mjs",
    "experiment:trajectory": "node scripts/run-b07-trajectory-experiment.mjs",
    "experiment:trajectory-compiler": "node scripts/run-b08-trajectory-compiler-experiment.mjs",
    "experiment:path-security": "node scripts/run-b10-path-security-experiment.mjs --final",
    "experiment:asset-inventory": "node scripts/run-b11-asset-inventory.mjs",
    "experiment:asset-security": "node scripts/run-b11-asset-security-experiment.mjs --final",
    "experiment:resource-budget": "node scripts/run-b12-resource-budget-experiment.mjs",
    "compile:restricted": "node scripts/run-restricted-blender-compile.mjs",
    "experiment:compile-receipt": "node scripts/run-b13-compile-receipt-experiment.mjs",
    "verify:receipt": "node scripts/verify-compile-receipt.mjs",
    "review:aggregate-b04": "node scripts/aggregate-b04-reviews.mjs",
    "review:aggregate-b04-v02": "node scripts/aggregate-b04-reviews.mjs --schema specs/human-review-response.v0.2.schema.json",
    "review:aggregate-b05": "node scripts/aggregate-b05-reviews.mjs --input-dir experiments/grasp-v0-2/reviews --output experiments/grasp-v0-2/human-review-status.json",
    "review:aggregate-b09": "node scripts/aggregate-b09-reviews.mjs --input-dir experiments/physics-review-v0-1/reviews --output experiments/physics-review-v0-1/human-review-status.json",
    "review:test-b09": "node scripts/test-b09-review-contract.mjs",
    "evaluate:actor": "node scripts/run-actor-evaluation.mjs",
    "render:compiler-previews": "node scripts/render-compiler-previews.mjs"
