{
  "name": "blender-film-studio-research",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate:spec": "node scripts/validate-scene-spec.mjs",
